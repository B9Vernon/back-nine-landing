# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never leaves this machine.

# Required — your Anthropic API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — Claude model NIB2 uses (default: claude-opus-4-8)
NIB2_MODEL=claude-opus-4-8

# Optional — port the server listens on (default: 3900)
NIB2_PORT=3900

# Optional — set a password to require it from both computers.
# Leave blank to disable the password gate (fine on a trusted home network).
NIB2_PASSWORD=

# ─────────────────────────────────────────────────────────────
# VOICE — ElevenLabs (human-sounding speech). Optional.
# If both are set, NIB2 speaks with your ElevenLabs voice. If not, it falls
# back to the browser's built-in voice automatically. Key stays server-side.
#   1. Get your API key: https://elevenlabs.io  → Profile → API Keys
#   2. Get your Voice ID: ElevenLabs → Voices → your voice → "ID" (copy it)
# ─────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional — TTS model. Default is eleven_turbo_v2_5 (fast + cheaper).
# Alternatives: eleven_multilingual_v2 (higher quality, slower).
ELEVENLABS_MODEL_ID=

# ─────────────────────────────────────────────────────────────
# GMAIL — read / search / draft (never sends). Optional.
# NIB2 uses Google OAuth. Your Gmail password is never asked for or stored.
# Setup (see README section "Gmail"):
#   1. https://console.cloud.google.com → new project
#   2. Enable the "Gmail API"
#   3. Create OAuth credentials (type: Web application)
#   4. Add this redirect URI EXACTLY:  http://localhost:3900/api/gmail/callback
#   5. Paste the client ID + secret below
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3900/api/gmail/callback

# ─────────────────────────────────────────────────────────────
# GMAIL VIA N8N (easier alternative to the Google OAuth above).
# Your n8n workflow owns the Google connection; NIB2 just polls its
# Webhook production URL for unread emails. In n8n: Webhook trigger
# (GET, Respond: "When Last Node Finishes") → Gmail "Get Many"
# (search: in:inbox is:unread, Simplify ON) → toggle workflow ACTIVE
# → copy the PRODUCTION URL here. If both Gmail methods are set,
# n8n wins.
# ─────────────────────────────────────────────────────────────
N8N_GMAIL_WEBHOOK_URL=
