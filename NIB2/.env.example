# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never leaves this machine.

# Required — your Anthropic API key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — Claude model NIB2 uses (default: claude-opus-4-8)
NIB2_MODEL=claude-opus-4-8

# Optional — port the server listens on (default: 3900)
NIB2_PORT=3900

# Optional — set a password to require it from both computers.
# Leave blank to disable the password gate (fine on a trusted home network).
NIB2_PASSWORD=
